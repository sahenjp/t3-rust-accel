index 0000000000..b40c39868a
--- /dev/null
+++ b/apps/server/src/orchestration-v2/ContextHandoffCompact.test.ts
@@ -0,0 +1,237 @@
+import { assert, it } from "@effect/vitest";
+import {
+  MessageId,
+  ProviderInstanceId,
+  ProviderThreadId,
+  RunId,
+  ThreadId,
+  TurnItemId,
+  type OrchestrationV2Run,
+  type OrchestrationV2TurnItem,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+
+import { renderHistory } from "@t3tools/provider-core/server/handoffBudget";
+import * as IdAllocator from "@t3tools/provider-core/server/IdAllocator";
+import * as ContextHandoffService from "./ContextHandoffService.ts";
+
+const layerTest = ContextHandoffService.layer.pipe(Layer.provide(IdAllocator.layer));
+
+const now = DateTime.makeUnsafe("2026-01-01T00:00:00.000Z");
+const threadId = ThreadId.make("thread:compact");
+const sourceProviderThreadId = ProviderThreadId.make("provider-thread:source");
+const targetProviderThreadId = ProviderThreadId.make("provider-thread:target");
+
+const withHandoffEnv = <A, E, R>(value: string | undefined, effect: Effect.Effect<A, E, R>) =>
+  Effect.acquireUseRelease(
+    Effect.sync(() => {
+      const prior = process.env.T3_COMPACT_HANDOFF;
+      if (value === undefined) delete process.env.T3_COMPACT_HANDOFF;
+      else process.env.T3_COMPACT_HANDOFF = value;
+      return prior;
+    }),
+    () => effect,
+    (prior) =>
+      Effect.sync(() => {
+        if (prior === undefined) delete process.env.T3_COMPACT_HANDOFF;
+        else process.env.T3_COMPACT_HANDOFF = prior;
+      }),
+  );
+
+const run = (id: string, ordinal: number): OrchestrationV2Run => ({
+  id: RunId.make(id),
+  threadId,
+  ordinal,
+  providerInstanceId: ProviderInstanceId.make("codex"),
+  modelSelection: { instanceId: ProviderInstanceId.make("codex"), model: "gpt-5.4" },
+  providerThreadId: sourceProviderThreadId,
+  userMessageId: MessageId.make(`message:${id}`),
+  rootNodeId: null,
+  activeAttemptId: null,
+  status: "completed",
+  requestedAt: now,
+  startedAt: now,
+  completedAt: now,
+  checkpointId: null,
+  contextHandoffId: null,
+});
+
+const itemBase = (id: string, runId: string | null, ordinal: number) => ({
+  id: TurnItemId.make(`turn-item:${id}`),
+  threadId,
+  runId: runId === null ? null : RunId.make(runId),
+  nodeId: null,
+  providerThreadId: sourceProviderThreadId,
+  providerTurnId: null,
+  nativeItemRef: null,
+  parentItemId: null,
+  ordinal,
+  status: "completed" as const,
+  title: null,
+  startedAt: now,
+  completedAt: now,
+  updatedAt: now,
+});
+
+const userItem = (id: string, runId: string, ordinal: number, text: string) =>
+  ({
+    ...itemBase(id, runId, ordinal),
+    createdBy: "user",
+    creationSource: "server",
+    type: "user_message",
+    messageId: MessageId.make(`message:${id}`),
+    inputIntent: "turn_start",
+    text,
+    attachments: [],
+  }) as OrchestrationV2TurnItem;
+
+const assistantItem = (id: string, runId: string, ordinal: number, text: string) =>
+  ({
+    ...itemBase(id, runId, ordinal),
+    type: "assistant_message",
+    messageId: MessageId.make(`message:${id}`),
+    text,
+    streaming: false,
+  }) as OrchestrationV2TurnItem;
+
+const commandItem = (id: string, runId: string, ordinal: number, output: string) =>
+  ({
+    ...itemBase(id, runId, ordinal),
+    type: "command_execution",
+    input: "vp test run",
+    output,
+    exitCode: 1,
+  }) as OrchestrationV2TurnItem;
+
+// Small enough that every historical item fits the default 16k cap in both modes.
+const fittingItems: ReadonlyArray<OrchestrationV2TurnItem> = [
+  userItem("u1", "run:one", 1, "Please fix the flaky handoff test."),
+  commandItem("cmd1", "run:two", 2, `HEAD-START ${"o".repeat(5_000)} TAIL-END`),
+  commandItem("cmd2", "run:two", 3, `second ${"y".repeat(2_000)} end`),
+  assistantItem("a1", "run:two", 4, "Fixed the assertion."),
+];
+
+// Big enough that several items fall out of the default cap in both modes.
+const overflowingItems: ReadonlyArray<OrchestrationV2TurnItem> = [
+  userItem("u1", "run:one", 1, "Please fix the flaky handoff test."),
+  commandItem("cmd1", "run:two", 2, `HEAD-START ${"o".repeat(9_000)} TAIL-END`),
+  assistantItem("a1", "run:two", 3, "Fixed the assertion."),
+  ...Array.from({ length: 10 }, (_, index) =>
+    assistantItem(`big-${index}`, "run:two", 4 + index, `bulk-${index} ` + "x".repeat(5_000)),
+  ),
+];
+
+const handoffInput = (items: ReadonlyArray<OrchestrationV2TurnItem>, targetRunId: string) => ({
+  threadId,
+  targetRunId: RunId.make(targetRunId),
+  transferId: null,
+  fromProviderThreadIds: [sourceProviderThreadId],
+  toProviderThreadId: targetProviderThreadId,
+  fromProviderInstanceId: ProviderInstanceId.make("codex"),
+  toProviderInstanceId: ProviderInstanceId.make("claude"),
+  coveredRunOrdinals: { from: 1, to: 2 },
+  strategy: "full_thread_summary" as const,
+  items,
+  runs: [run("run:one", 1), run("run:two", 2)],
+  createdAt: now,
+});
+
+const deliveredText = (handoff: {
