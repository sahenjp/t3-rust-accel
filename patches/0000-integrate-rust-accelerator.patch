+        ...flag("--max-bytes", maxBytes),
+      ]),
+    ),
+  ),
+  code_diff: McpToolAccess.reads(({ cwd, rev, path, maxBytes }) =>
+    Effect.flatMap(MakiMcpService.MakiMcpService, (maki) =>
+      maki.run([
+        "diff",
+        "--cwd",
+        cwd,
