index 0000000000..cc4d0e9bba
--- /dev/null
+++ b/apps/server/src/mcp/McpDeferredTools.test.ts
@@ -0,0 +1,577 @@
+import { NodeHttpServer } from "@effect/platform-node";
+import * as NodeCrypto from "@effect/platform-node/NodeCrypto";
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import {
+  EnvironmentId,
+  OrchestratorMcpFailure,
+  ProviderInstanceId,
+  ThreadId,
+} from "@t3tools/contracts";
+import { expect, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import { McpSchema, Tool, Toolkit } from "effect/ai";
+import { HttpBody, HttpClient, HttpRouter } from "effect/http";
+
+import * as ThreadManagementService from "../orchestration-v2/ThreadManagementService.ts";
+import * as ServerSettings from "../serverSettings.ts";
+import * as MakiMcpService from "./MakiMcpService.ts";
+import * as McpHttpServer from "./McpHttpServer.ts";
+import * as McpSessionRegistry from "./McpSessionRegistry.ts";
+import * as McpToolAccess from "./McpToolAccess.ts";
+import * as McpToolAccessTestkit from "./McpToolAccess.testkit.ts";
+import * as McpToolExposure from "./McpToolExposure.ts";
+import * as MakiHandlers from "./toolkits/maki/handlers.ts";
+import { MakiToolkit } from "./toolkits/maki/tools.ts";
+import { McpServer } from "effect/ai";
+import * as McpInvocationContext from "./McpInvocationContext.ts";
+
+const getEnv = (name: string) => process.env[name];
+const setEnv = (name: string, value: string | undefined) => {
+  if (value === undefined) delete process.env[name];
+  else process.env[name] = value;
+};
+
+const environmentId = EnvironmentId.make("environment-mcp-defer-test");
+const threadId = ThreadId.make("thread-mcp-defer-test");
+
+const invocation = {
+  environmentId,
+  requestNamespace: "provider-session-defer-test",
+  thread: {
+    threadId,
+    providerSessionId: "provider-session-defer-test",
+    providerInstanceId: ProviderInstanceId.make("codex"),
+  },
+  client: undefined,
+  capabilities: new Set(["orchestration"] as const),
+  issuedAt: 1,
+};
+const client = McpSchema.McpServerClient.of({
+  clientId: 1,
+  clientCapabilities: {},
+  clientInfo: { name: "mcp-test", version: "1.0.0" },
+  protocolVersion: "2025-06-18",
+  initializePayload: {
+    protocolVersion: "2025-06-18",
+    capabilities: {},
+    clientInfo: { name: "mcp-test", version: "1.0.0" },
+  },
+  getClient: Effect.die("unused"),
+});
+
+it.effect("static tool_search does not load matches and returns their schemas", () =>
+  Effect.gen(function* () {
+    let announced = 0;
+    const exposure = McpToolExposure.make(
+      () => [
+        { name: "tool_search", description: "search" },
+        { name: "tool_invoke", description: "invoke" },
+        { name: "t3_project_list", description: "lists projects", inputSchema: { type: "object" } },
+      ],
+      () => {
+        announced += 1;
+        return Effect.void;
+      },
+      {
+        staticList: true,
+        directTools: McpToolExposure.DEFERRED_DIRECT_TOOLS,
+        includeSchemas: true,
+      },
+    );
+    const found = yield* exposure.search("session-a", "project");
+    expect(found).toEqual([
+      { name: "t3_project_list", description: "lists projects", inputSchema: { type: "object" } },
+    ]);
+    expect(announced).toBe(0);
+    // Direct set stays listed; searched tools do not get loaded in static mode.
+    expect(exposure.isListed("session-a", "tool_search")).toBe(true);
+    expect(exposure.isListed("session-a", "tool_invoke")).toBe(true);
+    expect(exposure.isListed("session-a", "t3_project_list")).toBe(false);
+  }),
+);
+
+it.effect("non-static tool_search loads matches and announces the change", () =>
+  Effect.gen(function* () {
+    let announced = 0;
+    const exposure = McpToolExposure.make(
+      () => [{ name: "t3_project_list", description: "lists projects" }],
+      () => {
+        announced += 1;
+        return Effect.void;
+      },
+    );
+    const found = yield* exposure.search("session-a", "project");
+    expect(found.map((tool) => tool.name)).toEqual(["t3_project_list"]);
+    expect(announced).toBe(1);
+    expect(exposure.isListed("session-a", "t3_project_list")).toBe(true);
+  }),
+);
+
+const tool = (name: string, description: string) =>
+  Tool.make(name, {
+    description,
+    success: Schema.Struct({ ok: Schema.Boolean }),
+    failure: OrchestratorMcpFailure,
+    failureMode: "return",
+  });
+
+const DeferTestToolkit = Toolkit.make(
+  tool("orchestrator_capabilities", "Lists provider capabilities."),
+  tool("delegate_task", "Delegates a task."),
+  tool("task_status", "Reads a task."),
+  tool("t3_project_list", "Lists projects."),
+  tool("preview_open", "Opens a browser preview."),
+);
+const okReads = McpToolAccess.reads(() => Effect.succeed({ ok: true }));
+
+const layerDeferTest = Layer.mergeAll(
+  McpHttpServer.toolkitRegistration(
+    DeferTestToolkit,
+    McpToolAccess.toLayer(DeferTestToolkit, {
+      orchestrator_capabilities: okReads,
+      delegate_task: okReads,
+      task_status: okReads,
+      t3_project_list: okReads,
+      preview_open: okReads,
+    }),
+  ),
+  McpHttpServer.layerToolInvoke,
+  McpHttpServer.layerToolSearch,
+);
+
+const httpSession = () =>
+  Effect.gen(function* () {
+    const httpClient = yield* HttpClient.HttpClient;
+    const headers = {
+      accept: "application/json, text/event-stream",
+      authorization: `Bearer ${invocation.requestNamespace}`,
+    };
+    const initialize = yield* httpClient.post("/mcp", {
+      headers,
+      body: HttpBody.text(
+        `{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"probe","version":"1.0.0"}}}`,
+        "application/json",
+      ),
+    });
+    const rpc = (method: string, params: object) =>
+      httpClient
+        .post("/mcp", {
+          headers: {
+            ...headers,
+            "mcp-session-id": initialize.headers["mcp-session-id"]!,
+            "mcp-protocol-version": "2025-06-18",
+          },
+          body: HttpBody.text(
+            JSON.stringify({ jsonrpc: "2.0", id: 2, method, params }),
+            "application/json",
+          ),
+        })
+        .pipe(
+          Effect.flatMap((response) => response.text),
+          Effect.map((text): unknown =>
+            text
+              .split("\n")
+              .filter((line) => line.startsWith("data: ") || line.startsWith("{"))
+              .map((line) => JSON.parse(line.replace(/^data: /u, "")) as { id?: number })
+              .find((message) => message.id === 2),
+          ),
+        );
+    const listRaw = rpc("tools/list", {}).pipe(
+      Effect.map((body) => (body as { result: { tools: ReadonlyArray<unknown> } }).result.tools),
+    );
+    const call = (name: string, args: object) =>
+      rpc("tools/call", { name, arguments: args }).pipe(
+        Effect.map(
+          (body) => (body as { result: { structuredContent?: unknown; isError?: boolean } }).result,
+        ),
+      );
+    return { listRaw, call };
+  });
+
+it.effect("T3_DEFER_MCP_TOOLS=1 + T3_STATIC_TOOL_LIST=1 gives a static compact list", () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const priorDefer = getEnv("T3_DEFER_MCP_TOOLS");
+      const priorStatic = getEnv("T3_STATIC_TOOL_LIST");
+      setEnv("T3_DEFER_MCP_TOOLS", "1");
+      setEnv("T3_STATIC_TOOL_LIST", "1");
+      yield* Effect.addFinalizer(() =>
+        Effect.sync(() => {
+          setEnv("T3_DEFER_MCP_TOOLS", priorDefer);
+          setEnv("T3_STATIC_TOOL_LIST", priorStatic);
+        }),
+      );
+
+      const serverLayer = McpHttpServer.layerMcpTransport(layerDeferTest).pipe(
+        Layer.provide(ServerSettings.layerTest()),
+        Layer.provide(McpToolAccessTestkit.liveThreadsLayer),
+        Layer.provide(
+          Layer.mock(McpSessionRegistry.McpSessionRegistry)({
+            resolve: (token) =>
+              Effect.succeed(token === invocation.requestNamespace ? invocation : undefined),
+          }),
+        ),
+      );
+      yield* HttpRouter.serve(serverLayer, { disableListenLog: true, disableLogger: true }).pipe(
+        Layer.build,
+      );
+      const session = yield* httpSession();
+
+      const list1 = yield* session.listRaw;
+      const names1 = list1.map((listed) => (listed as { name: string }).name);
+      expect([...names1].sort()).toEqual([
+        "delegate_task",
+        "orchestrator_capabilities",
+        "task_status",
+        "tool_invoke",
+        "tool_search",
+      ]);
+      // tool_search discovers with schemas and does not mutate the list.
+      const search = yield* session.call("tool_search", { query: "project" });
+      const found = (
+        search.structuredContent as { tools: Array<{ name: string; inputSchema?: unknown }> }
+      ).tools;
+      expect(found[0]?.name).toBe("t3_project_list");
+      expect(found[0]?.inputSchema).toBeDefined();
+      const list2 = yield* session.listRaw;
+      expect(JSON.stringify(list2)).toBe(JSON.stringify(list1));
+      // tool_invoke dispatches to the unlisted tool with the caller's checks.
+      const invoked = yield* session.call("tool_invoke", {
+        name: "t3_project_list",
+        arguments: {},
+      });
+      expect(invoked.structuredContent).toEqual({ ok: true });
+      // Direct tools/call to deferred tools still works (calls are never gated).
+      const direct = yield* session.call("preview_open", {});
+      expect(direct.structuredContent).toEqual({ ok: true });
+    }),
+  ).pipe(Effect.provide(NodeHttpServer.layerTest)),
+);
+
+it.effect("T3_COMPACT_TOOL_SCHEMAS=1 shrinks tools/list while tool_search keeps full detail", () =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const priorDefer = getEnv("T3_DEFER_MCP_TOOLS");
+      const priorStatic = getEnv("T3_STATIC_TOOL_LIST");
+      const priorCompact = getEnv("T3_COMPACT_TOOL_SCHEMAS");
+      setEnv("T3_DEFER_MCP_TOOLS", "1");
+      setEnv("T3_STATIC_TOOL_LIST", "1");
+      yield* Effect.addFinalizer(() =>
+        Effect.sync(() => {
+          setEnv("T3_DEFER_MCP_TOOLS", priorDefer);
+          setEnv("T3_STATIC_TOOL_LIST", priorStatic);
+          setEnv("T3_COMPACT_TOOL_SCHEMAS", priorCompact);
+        }),
+      );
+
+      const layer = layerDeferTest.pipe(
+        Layer.provideMerge(McpHttpServer.layerInProcessMcpServer),
+        Layer.provideMerge(McpToolAccessTestkit.liveThreadsLayer),
+        Layer.provideMerge(Layer.mergeAll(NodeServices.layer, NodeCrypto.layer)),
+      );
+      const measure = Effect.gen(function* () {
+        const server = yield* McpServer.McpServer;
+        const search = yield* server
+          .callTool({ name: "tool_search", arguments: { query: "project" } })
+          .pipe(
+            Effect.provideService(McpInvocationContext.McpInvocationContext, invocation),
+            Effect.provideService(McpSchema.McpServerClient, client),
+          );
+        return {
+          listed: server.tools.map(({ tool }) => tool),
+          found: (search.structuredContent?.tools ?? []) as ReadonlyArray<{
+            name: string;
+            description: string;
+            inputSchema?: unknown;
+          }>,
+        };
+      }).pipe(Effect.provide(layer));
+
+      const full = yield* measure;
+      setEnv("T3_COMPACT_TOOL_SCHEMAS", "1");
+      const compact = yield* measure;
+
+      const fullBytes = JSON.stringify(full.listed).length;
+      const compactBytes = JSON.stringify(compact.listed).length;
+      expect(compactBytes).toBeLessThan(fullBytes);
+      // Schema noise and overlong descriptions are gone; a second compact
+      // build serializes byte-identically for KV-cache-friendly listings.
+      const again = yield* measure;
+      expect(JSON.stringify(again.listed)).toBe(JSON.stringify(compact.listed));
+      const schemaText = JSON.stringify(compact.listed.map((tool) => tool.inputSchema));
+      expect(schemaText).not.toContain('"$schema"');
+      expect(schemaText).not.toContain('"additionalProperties":false');
+      expect(
+        Math.max(...compact.listed.map((tool) => (tool.description ?? "").length)),
+      ).toBeLessThanOrEqual(161);
+      // tool_search still answers the unshrunk schema and description.
+      const found = compact.found.find((listed) => listed.name === "t3_project_list");
+      expect(found?.description).toBe("Lists projects.");
+      expect(JSON.stringify(found?.inputSchema)).toBe(
+        JSON.stringify(full.found.find((listed) => listed.name === "t3_project_list")?.inputSchema),
+      );
+    }),
+  ),
+);
+
+it.effect("T3_DEDUP_MCP_CONTENT=1 drops structuredContent a text item repeats", () =>
+  Effect.acquireUseRelease(
+    // The flag must be set before the registration layer builds.
+    Effect.sync(() => {
+      const prior = getEnv("T3_DEDUP_MCP_CONTENT");
+      setEnv("T3_DEDUP_MCP_CONTENT", "1");
+      return prior;
+    }),
+    () =>
+      Effect.gen(function* () {
+        const server = yield* McpServer.McpServer;
+        // failureMode "return" tools encode { ok: true } in both places; dedup keeps text only.
+        const deduped = yield* server
+          .callTool({ name: "t3_project_list", arguments: {} })
+          .pipe(
+            Effect.provideService(McpInvocationContext.McpInvocationContext, invocation),
+            Effect.provideService(McpSchema.McpServerClient, client),
+          );
+        expect(deduped.structuredContent).toBeUndefined();
+        expect(deduped.content).toEqual([{ type: "text", text: '{"ok":true}' }]);
+      }).pipe(
+        Effect.provide(
+          layerDeferTest.pipe(
+            Layer.provideMerge(McpHttpServer.layerInProcessMcpServer),
+            Layer.provideMerge(McpToolAccessTestkit.liveThreadsLayer),
+            Layer.provideMerge(Layer.mergeAll(NodeServices.layer, NodeCrypto.layer)),
+          ),
+        ),
+      ),
+    (prior) => Effect.sync(() => setEnv("T3_DEDUP_MCP_CONTENT", prior)),
+  ),
+);
+
+it("dedupToolResult compacts pretty JSON and drops only exact duplicates", () => {
+  const pretty = JSON.stringify({ a: 1, b: { c: 2 } }, null, 2);
+  const duplicated = McpHttpServer.dedupToolResult(
+    new McpSchema.CallToolResult({
+      isError: false,
+      structuredContent: { a: 1, b: { c: 2 } },
+      content: [{ type: "text", text: pretty }],
+    }),
+  );
+  expect(duplicated.structuredContent).toBeUndefined();
+  expect(duplicated.content).toEqual([{ type: "text", text: '{"a":1,"b":{"c":2}}' }]);
+
+  // A text item that is not the whole payload leaves structuredContent alone.
+  const distinct = McpHttpServer.dedupToolResult(
+    new McpSchema.CallToolResult({
+      isError: false,
+      structuredContent: { a: 1 },
+      content: [
+        { type: "text", text: '{"url":"https://x"}' },
+        { type: "text", text: "prose, not json" },
+      ],
+    }),
+  );
+  expect(distinct.structuredContent).toEqual({ a: 1 });
+  expect(distinct.content).toEqual([
+    { type: "text", text: '{"url":"https://x"}' },
+    { type: "text", text: "prose, not json" },
+  ]);
+});
+
+it("truncateToolResult reserves the marker budget without splitting surrogate pairs", () => {
+  const hasLoneSurrogate = (value: string) => {
+    for (let index = 0; index < value.length; index++) {
+      const code = value.charCodeAt(index);
+      if (code >= 0xd800 && code <= 0xdbff) {
+        const next = value.charCodeAt(index + 1);
+        if (next < 0xdc00 || next > 0xdfff) return true;
+      }
+      if (code >= 0xdc00 && code <= 0xdfff) {
+        const previous = value.charCodeAt(index - 1);
+        if (previous < 0xd800 || previous > 0xdbff) return true;
+      }
+    }
+    return false;
+  };
+  const text = `${"a".repeat(12)}😀${"b".repeat(80)}😀${"c".repeat(80)}`;
+  const truncated = McpHttpServer.truncateToolResult(
+    new McpSchema.CallToolResult({
+      content: [{ type: "text", text }],
+    }),
+    100,
+  );
+  const output = (truncated.content?.[0] as { text: string }).text;
+  expect(output.length).toBeLessThanOrEqual(100);
+  expect(output).toContain("…[truncated ");
+  expect(hasLoneSurrogate(output)).toBe(false);
+
+  const small = McpHttpServer.truncateToolResult(
+    new McpSchema.CallToolResult({
+      content: [{ type: "text", text: `a😀${"x".repeat(80)}` }],
+    }),
+    2,
+  );
+  expect((small.content?.[0] as { text: string }).text).toBe("a");
+});
+
+it.effect("code_grep and code_diff forward flags to t3-maki-tools", () =>
+  Effect.gen(function* () {
+    const ran: Array<ReadonlyArray<string>> = [];
+    const layer = McpHttpServer.toolkitRegistration(MakiToolkit, MakiHandlers.layer).pipe(
+      Layer.provideMerge(McpHttpServer.layerInProcessMcpServer),
+      Layer.provide(
+        Layer.mergeAll(
+          Layer.succeed(
+            MakiMcpService.MakiMcpService,
+            MakiMcpService.MakiMcpService.of({
+              available: Effect.succeed(true),
+              run: (args) =>
+                Effect.sync(() => {
+                  ran.push(args);
+                  return { ok: true };
+                }),
+            }),
