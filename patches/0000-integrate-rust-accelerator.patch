diff --git a/apps/server/src/mcp/MakiMcpService.ts b/apps/server/src/mcp/MakiMcpService.ts
new file mode 100644
index 0000000000..70fdacd51e
--- /dev/null
+++ b/apps/server/src/mcp/MakiMcpService.ts
@@ -0,0 +1,112 @@
+import * as NodePath from "node:path";
+
+import { OrchestratorMcpFailure } from "@t3tools/contracts";
+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Schema from "effect/Schema";
+import * as Stream from "effect/Stream";
+import { ChildProcess, ChildProcessSpawner } from "effect/process";
+
+const DEFAULT_BIN = "t3-maki-tools";
+
+const decodeJsonOutput = Schema.decodeEffect(Schema.fromJsonString(Schema.Unknown));
+
+const unavailable = (bin: string) =>
+  new OrchestratorMcpFailure({
+    code: "orchestration_error",
+    message: `Maki code tools are unavailable: ${bin} does not exist. Set T3_MAKI_TOOLS_BIN.`,
+  });
+
+const failed = (detail: string) =>
+  new OrchestratorMcpFailure({ code: "orchestration_error", message: detail });
+
+/**
+ * Thin async wrapper over the `t3-maki-tools` CLI. Spawning goes through
+ * `ChildProcessSpawner`, so it never blocks the event loop.
+ */
+export class MakiMcpService extends Context.Service<
+  MakiMcpService,
+  {
+    /** Runs `<bin> <args...>` with `stdin` piped in; parses the JSON stdout contract. */
+    readonly run: (
+      args: ReadonlyArray<string>,
+      options?: { readonly stdin?: string | undefined },
+    ) => Effect.Effect<unknown, OrchestratorMcpFailure>;
+    /** Whether the configured binary exists on disk. */
+    readonly available: Effect.Effect<boolean>;
+  }
+>()("t3/mcp/MakiMcpService") {}
+
+export const layer = Layer.effect(
+  MakiMcpService,
+  Effect.gen(function* () {
+    const fileSystem = yield* FileSystem.FileSystem;
+    const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
+    const configured = (process.env.T3_MAKI_TOOLS_BIN ?? DEFAULT_BIN).trim();
+    const encoder = new TextEncoder();
+
+    const statFile = (candidate: string, requireExecutable: boolean) =>
+      fileSystem.stat(candidate).pipe(
+        Effect.map(
+          (info) => info.type === "File" && (!requireExecutable || (info.mode & 0o111) !== 0),
+        ),
+        Effect.orElseSucceed(() => false),
+      );
+    const resolveBinary = Effect.fnUntraced(function* () {
+      if (
+        configured.includes("/") ||
+        configured.includes("\\") ||
+        NodePath.isAbsolute(configured)
+      ) {
+        const resolved = NodePath.resolve(configured);
+        return (yield* statFile(resolved, false)) ? resolved : undefined;
+      }
+      if (configured === "") return undefined;
+      const names =
+        process.platform === "win32"
+          ? [configured, `${configured}.exe`, `${configured}.com`]
+          : [configured];
+      for (const entry of (process.env.PATH ?? "").split(
+        process.platform === "win32" ? ";" : ":",
+      )) {
+        if (!NodePath.isAbsolute(entry)) continue;
+        for (const name of names) {
+          const candidate = NodePath.join(entry, name);
+          if (yield* statFile(candidate, process.platform !== "win32")) return candidate;
+        }
+      }
+      return undefined;
+    });
+
+    const available = resolveBinary().pipe(Effect.map((resolved) => resolved !== undefined));
+
+    const run = Effect.fn("MakiMcpService.run")(function* (
+      args: ReadonlyArray<string>,
+      options?: { readonly stdin?: string | undefined },
+    ): Effect.fn.Return<unknown, OrchestratorMcpFailure> {
+      const resolved = yield* resolveBinary();
+      if (resolved === undefined) return yield* unavailable(configured);
+      const command = ChildProcess.make(resolved, [...args], {
+        stdin: options?.stdin === undefined ? "ignore" : Stream.make(encoder.encode(options.stdin)),
+      });
+      const stdout = yield* spawner.string(command).pipe(
+        Effect.mapError((error) =>
+          failed(`t3-maki-tools ${args[0] ?? ""} failed: ${error.message}`),
+        ),
+        Effect.timeoutOrElse({
+          duration: "45 seconds",
+          orElse: () => Effect.fail(failed(`t3-maki-tools ${args[0] ?? ""} timed out after 45s`)),
+        }),
+      );
+      return yield* decodeJsonOutput(stdout).pipe(
+        Effect.mapError(() =>
+          failed(`t3-maki-tools ${args[0] ?? ""} produced no JSON: ${stdout.slice(0, 200)}`),
+        ),
+      );
+    });
+
+    return MakiMcpService.of({ run, available });
+  }),
+);
diff --git a/apps/server/src/mcp/McpDeferredTools.test.ts b/apps/server/src/mcp/McpDeferredTools.test.ts
