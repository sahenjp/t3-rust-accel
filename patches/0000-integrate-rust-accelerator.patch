+        ...flag("--start", start),
+        ...flag("--end", end),
+        ...flag("--max-bytes", maxBytes),
+      ]),
+    ),
+  ),
+  code_grep: McpToolAccess.reads(({ pattern, path, glob, maxHits, maxBytes }) =>
