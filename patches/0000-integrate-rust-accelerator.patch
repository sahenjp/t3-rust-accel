+        "index",
+        "--path",
+        path,
+        ...flag("--max-depth", maxDepth),
+        ...flag("--max-lines", maxLines),
+      ]),
+    ),
+  ),
+  code_slice: McpToolAccess.reads(({ path, symbol, start, end, maxBytes }) =>
+    Effect.flatMap(MakiMcpService.MakiMcpService, (maki) =>
+      maki.run([
+        "slice",
+        "--path",
+        path,
