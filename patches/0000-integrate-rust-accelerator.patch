+    path: Schema.String,
+    symbol: Schema.optional(Schema.String),
+    start: Schema.optional(PositiveInt),
+    end: Schema.optional(PositiveInt),
+    maxBytes: Schema.optional(PositiveInt.check(Schema.isLessThanOrEqualTo(1_048_576))),
+  }),
+  success: Schema.Unknown,
+  failure: OrchestratorMcpFailure,
+  failureMode: "return",
+  dependencies: [McpInvocationContext.McpInvocationContext, MakiMcpService.MakiMcpService],
